bash-available-env = 💡 கிடைக்கும் சூழல் மாறிகள்:
bash-env-target-dir =    • TARGET_DIR - ஸ்கேன் செய்ய வேண்டிய இலக்கு அடைவு
bash-env-output-dir =    • OUTPUT_DIR - வெளியீட்டு அடைவு
bash-env-output-suffix =    • OUTPUT_FILE_SUFFIX - வெளியீட்டுக் கோப்புப் பெயர் பின்னொட்டு
bash-env-max-size =    • MAX_SIZE_BYTES - அதிகபட்ச கோப்பு அளவு
bash-env-use-gitignore =    • USE_GITIGNORE - .gitignore பயன்படுத்து (true/false)
bash-env-verbose =    • VERBOSE - விரிவான முறை (true/false)
bash-env-ignore-files =    • IGNORE_FILES_EXTRA - கூடுதலாக புறக்கணிக்க வேண்டிய கோப்புகள் (குழாய்-பிரிக்கப்பட்டவை)
bash-env-ignore-dirs =    • IGNORE_DIRS_EXTRA - கூடுதலாக புறக்கணிக்க வேண்டிய அடைவுகள் (குழாய்-பிரிக்கப்பட்டவை)
bash-env-ignore-paths =    • IGNORE_PATHS - புறக்கணிக்க வேண்டிய குறிப்பிட்ட தொடர்புடைய பாதைகள் (குழாய்-பிரிக்கப்பட்டவை)
bash-env-ignore-absolute =    • IGNORE_ABSOLUTE_PATHS - புறக்கணிக்க வேண்டிய குறிப்பிட்ட முழுமையான பாதைகள் (குழாய்-பிரிக்கப்பட்டவை)
